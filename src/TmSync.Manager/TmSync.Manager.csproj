<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Allows compiling the Windows desktop app from non-Windows build agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyTitle>TmSync Manager</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TmSync.Service\TmSync.Service.csproj" />
  </ItemGroup>

</Project>
